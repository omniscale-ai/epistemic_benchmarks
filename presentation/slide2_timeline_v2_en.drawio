                <mxCell id="card24" parent="1" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#00204D;fillColor=#F9F9F9;strokeColor=#4F6D99;strokeWidth=2;spacingLeft=8;spacingTop=6;spacingRight=6;" value="&lt;b&gt;1 · Law from a table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#004381&quot;&gt;1977–2021&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#004381&quot;&gt;AI Feynman, SRBench&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Input: &lt;/b&gt;a table of numbers from a formula&lt;br&gt;&lt;font style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;Output: &lt;/b&gt;a formula&lt;br&gt;&lt;font style=&quot;font-size:6px&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;Scored: &lt;/b&gt;exact symbolic match&lt;/font&gt;" vertex="1">
